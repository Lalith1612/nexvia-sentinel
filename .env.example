# Sentinel Platform Environment Configuration

# App Configuration
APP_NAME=Sentinel Fraud Detection
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1
SECRET_KEY=sentinel-super-secret-key-change-in-production-2026

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database (PostgreSQL / SQLite fallback for lightweight local dev)
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secure_pass
POSTGRES_DB=sentinel_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Apache Kafka (Phase 6 Real-Time Transaction Streaming)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTIONS_TOPIC=sentinel.transactions
KAFKA_RESULTS_TOPIC=sentinel.fraud-predictions
KAFKA_ALERTS_TOPIC=sentinel.fraud-alerts
KAFKA_DLQ_TOPIC=sentinel.transactions.dlq
KAFKA_CONSUMER_GROUP=sentinel-inference-group
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_MS=200
KAFKA_POLL_TIMEOUT_SEC=1.0
USE_MOCK_STREAMING=false

# Feast Feature Store
FEAST_USAGE=true
FEAST_REPO_PATH=./feature_store

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=sentinel-fraud-detection

# Model Thresholds
FRAUD_CRITICAL_THRESHOLD=0.85
FRAUD_HIGH_THRESHOLD=0.65
FRAUD_MEDIUM_THRESHOLD=0.40
